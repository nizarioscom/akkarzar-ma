# Supabase Postgres (pooler — port 6543) used by Prisma at runtime
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true"

# Supabase Postgres (direct — port 5432) used for migrations
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# 32-byte key, base64-encoded. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=""

# Supabase Auth (publishable key is safe for the browser; never put service_role here)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Optional legacy alias if the project still uses an anon key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Object storage (AWS S3 or OVH S3-compatible). If S3_BUCKET is empty, uploads stay local-metadata only.
S3_BUCKET=""
S3_REGION="gra"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Optional external OCR extractor
OCR_EXTRACTOR_URL=""
OCR_EXTRACTOR_TOKEN=""

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
